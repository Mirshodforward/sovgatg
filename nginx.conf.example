# sovgatg.uz — statik sayt uchun nginx namunasi.
# Serverga qo'yish: /etc/nginx/sites-available/sovgatg.uz → sites-enabled ga symlink.
# TLS: sudo certbot --nginx -d sovgatg.uz -d www.sovgatg.uz

# www → asosiy domenga (SEO: bitta kanonik manzil bo'lsin)
server {
    listen 80;
    listen [::]:80;
    server_name www.sovgatg.uz;
    return 301 https://sovgatg.uz$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name sovgatg.uz;

    root /var/www/sovgatg.uz;      # bu yerga dist/ ichidagi fayllar ko'chiriladi
    index index.html;
    charset utf-8;

    # Toza manzillar: /nft-sovga-ijara/ → /nft-sovga-ijara/index.html
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;

    # ── Siqish. Buni o'tkazib yuborish qimmatga tushadi:
    #    gzip_types sozlanmasa, faqat text/html siqiladi, CSS/JS xom ketadi.
    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml
        application/javascript application/json
        application/xml application/manifest+json
        image/svg+xml;

    # ── Kesh. Assetlar uzoq, HTML qisqa: kontent yangilansa darhol ko'rinsin.
    location ~* \.(css|js|svg|png|jpe?g|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }
    location ~* \.(html|xml|txt|webmanifest)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600, must-revalidate";
    }

    # ── Xavfsizlik sarlavhalari
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Yashirin fayllarga kirishni yopamiz
    location ~ /\. { deny all; }
}
