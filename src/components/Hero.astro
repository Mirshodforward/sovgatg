---
---

<section class="hero" id="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        Telegram Stars, Premium<br>
        va noyob Sovg'alar<br>
        <span class="hero-highlight">5 soniyada!</span>
      </h1>
      <p class="hero-desc">
        StarsPaymee — Telegram sovg'alari, Stars va Premium eng arzon narxlarda. Uzcard, Humo, Click, Payme, Uzum, Paynet — istalgan bank ilovasi orqali so'mda to'lang. 5 soniyada yetkaziladi, kechiksa bonus.
      </p>
      <div class="hero-buttons">
        <a href="https://t.me/StarsPaymee_bot" class="btn-primary" target="_blank">
          &#9889; Botga o'tish
        </a>
        <a href="#services" class="btn-secondary">
          Xizmatlarni ko'rish &#8595;
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <img src="/logo.png" alt="StarsPaymee" class="hero-logo" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 100px 0 80px;
    overflow: hidden;
    background: linear-gradient(180deg, #FFF5F7 0%, #FFFFFF 100%);
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -200px; right: -200px;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(225, 29, 72, 0.08), transparent 70%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -100px; left: -200px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.06), transparent 70%);
    pointer-events: none;
  }

  .hero-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 60px;
    width: 100%;
  }

  .hero-content {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--text);
  }
  .hero-highlight {
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 36px;
    max-width: 520px;
    line-height: 1.7;
  }
  .hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-visual {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .hero-logo {
    width: 280px;
    height: 280px;
    border-radius: 48px;
    object-fit: cover;
    box-shadow:
      0 24px 64px rgba(225, 29, 72, 0.18),
      0 8px 24px rgba(245, 158, 11, 0.12);
  }

  @media (max-width: 1024px) {
    .hero { min-height: auto; }
    .hero-container {
      flex-direction: column;
      text-align: center;
      gap: 40px;
    }
    .hero-title { font-size: 2.6rem; }
    .hero-desc { margin: 0 auto 36px; }
    .hero-buttons { justify-content: center; }
    .hero-logo { width: 200px; height: 200px; border-radius: 36px; }
  }

  @media (max-width: 640px) {
    .hero { padding: 160px 16px 40px; }
    .hero-container { gap: 32px; }
    .hero-title { font-size: 2rem; line-height: 1.15; }
    .hero-desc { font-size: 1rem; margin-bottom: 24px; }
    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .hero-buttons :global(.btn-primary),
    .hero-buttons :global(.btn-secondary) {
      width: 100%;
      justify-content: center;
      padding: 14px 24px;
      font-size: 0.95rem;
    }
    .hero-logo { width: 140px; height: 140px; border-radius: 28px; }
  }
</style>
