---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = "StarsPaymee Haqida — Rasmiy Ma'lumot | Telegram Stars, Premium, Gifts";
const description = "StarsPaymee — O'zbekistonda Telegram Stars, Premium va Gifts xizmatlarini taqdim etuvchi platforma. Xizmatlar, kafolatlar, to'lov usullari va aloqa haqida to'liq rasmiy ma'lumot.";
---

<Layout
  title={title}
  description={description}
  canonical="https://sovgatg.uz/info"
  keywords="StarsPaymee haqida, StarsPaymee nima, StarsPaymee rasmiy, Telegram Stars xizmati, StarsPaymee aloqa, StarsPaymee kafolatlar"
  hreflangs={[
    { lang: "uz", href: "https://sovgatg.uz/info" },
    { lang: "ru", href: "https://sovgatg.uz/ru/info" }
  ]}
>
  <Navbar />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "StarsPaymee",
    "url": "https://sovgatg.uz",
    "logo": "https://sovgatg.uz/logo.png",
    "description": description,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "url": "https://t.me/StarsPaymee_bot",
        "availableLanguage": "Uzbek"
      }
    ],
    "sameAs": [
      "https://t.me/starspaymee",
      "https://t.me/StarsPaymee_bot"
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Bosh sahifa", "item": "https://sovgatg.uz" },
      { "@type": "ListItem", "position": 2, "name": "StarsPaymee Haqida", "item": "https://sovgatg.uz/info" }
    ]
  })} />

  <section class="info-hero">
    <div class="container">
      <div class="info-content">
        <nav class="breadcrumb">
          <a href="/">Bosh sahifa</a>
          <span>/</span>
          <span>Ma'lumot</span>
        </nav>
        <h1 class="info-title">StarsPaymee Haqida</h1>
        <p class="info-meta">sovgatg.uz &middot; @StarsPaymee_bot</p>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container">
      <div class="info-content">
        <p><strong>StarsPaymee</strong> — O'zbekistondagi Telegram foydalanuvchilari uchun mo'ljallangan xizmat platformasi. Biz Telegram Stars, Telegram Premium obuna va Telegram Gifts xizmatlarini tez, ishonchli va arzon narxlarda taqdim etamiz.</p>
        <p>Platformamiz <strong>@StarsPaymee_bot</strong> Telegram boti orqali ishlaydi. Foydalanuvchilar bot orqali xizmatni tanlaydi, to'lovni amalga oshiradi va 5 soniyada xizmatni qabul qiladi. StarsPaymee jamoasi har bir buyurtma uchun to'liq javobgarlikni o'z zimmamizga olamiz.</p>
      </div>
    </div>
  </section>

  <section class="info-section info-alt">
    <div class="container">
      <div class="info-content">
        <h2>Xizmatlar</h2>
        <p><strong>Telegram Stars</strong> — Telegramning ichki valyutasi bo'lib, kanallardagi premium kontentga kirish, botlardagi pullik xizmatlardan foydalanish va kontentmeykerlarni qo'llab-quvvatlash uchun ishlatiladi. StarsPaymee orqali Stars xarid qilish juda oson — 50 Stars dan boshlab istalgan miqdorda sotib olish mumkin. Ko'proq Stars xarid qilsangiz, har bir yulduz narxi arzonroq bo'ladi.</p>
        <p><strong>Telegram Premium</strong> obunasi foydalanuvchiga cheksiz imkoniyatlar ochib beradi: 4 GB gacha fayllarni yuklash, tezkor yuklab olish, kanallardagi reklamalardan xalos bo'lish, eksklyuziv stikerlar va reaktsiyalar, premium profil belgisi, animatsiyali avatar va real-time tarjima. StarsPaymee orqali 3 oylik, 6 oylik va 1 yillik muddatlarda obuna sotib olish mumkin.</p>
        <p><strong>Telegram Gifts</strong> — do'stlarga yoki yaqinlarga Telegram Premium ni sovg'a sifatida yuborish imkoniyati. Qabul qiluvchi hech qanday to'lovsiz Premium obunadan foydalana boshlaydi. Gift bilan birga maxsus tabrik xabari ham qo'shish mumkin. 3 oylik, 6 oylik va 1 yillik muddatlarda sovg'a qilish mumkin.</p>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container">
      <div class="info-content">
        <h2>Qanday ishlaydi?</h2>
        <p><strong>1.</strong> Telegramda <strong>@StarsPaymee_bot</strong> ni oching va /start bosing.</p>
        <p><strong>2.</strong> Stars, Premium yoki Gifts — o'zingizga kerakli xizmatni tanlang.</p>
        <p><strong>3.</strong> Uzcard, Humo, Click, Payme, Uzum yoki Paynet orqali so'mda to'lang.</p>
        <p><strong>4.</strong> To'lovdan so'ng 5 soniyada xizmat yetkaziladi.</p>
      </div>
    </div>
  </section>

  <section class="info-section info-alt">
    <div class="container">
      <div class="info-content">
        <h2>Kafolatlar</h2>
        <p><strong>5 soniyada yetkazish.</strong> To'lovdan so'ng 5 soniyada xizmat yetkazilishini kafolatlaymiz.</p>
        <p><strong>Kechiksa bonus.</strong> Agar buyurtmangiz kechiksa, sizga bonus beramiz.</p>
        <p><strong>To'liq pul qaytarish.</strong> Xizmat yetkazilmasa yoki muammo bo'lsa, to'langan summa 100% qaytariladi.</p>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container">
      <div class="info-content">
        <h2>To'lov usullari</h2>
        <p>StarsPaymee platformasida to'lov <strong>Uzcard, Humo, Click, Payme, Uzum, Paynet</strong> orqali so'mda amalga oshiriladi. Bot foydalanuvchiga qulay to'lov usulini tanlash imkonini beradi. To'lov jarayoni xavfsiz va tez — bir necha soniyada yakunlanadi.</p>
      </div>
    </div>
  </section>

  <section class="info-section info-alt">
    <div class="container">
      <div class="info-content">
        <h2>Referral dastur</h2>
        <p>StarsPaymee referral dasturi orqali qo'shimcha bonus olish mumkin. Botdan shaxsiy referral havolangizni oling va do'stlaringiz bilan ulashing. Har safar do'stingiz xarid qilganda, xarid summasining <strong>5%</strong> ini bonus sifatida olasiz.</p>
        <p><strong>1.</strong> Botdan o'zingizning referral havolangizni oling.</p>
        <p><strong>2.</strong> Havolani do'stlaringiz bilan ulashing.</p>
        <p><strong>3.</strong> Do'stingiz xarid qilganda 5% bonus oling.</p>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container">
      <div class="info-content">
        <h2>Aloqa</h2>
        <p>Bizga quyidagi kanallar orqali murojaat qilishingiz mumkin:</p>
        <p><strong>@StarsPaymee_bot</strong> — Xarid qilish va xizmatlardan foydalanish</p>
        <p><strong>@starspaymee</strong> — Rasmiy Telegram kanal — yangiliklar va e'lonlar</p>
        <p><strong>@starspaymee_bot</strong> — Qo'llab-quvvatlash xizmati — yordam va savollar</p>
      </div>
    </div>
  </section>

  <section class="info-section info-alt">
    <div class="container">
      <div class="info-content">
        <h2>Veb-sayt</h2>
        <p><strong>sovgatg.uz</strong> — StarsPaymee ning rasmiy veb-sayti. Saytda barcha xizmatlar haqida batafsil ma'lumot, foydalanuvchi fikrlari, ko'p beriladigan savollar va botga yo'naltiruvchi havolalar mavjud. Sayt o'zbek tilida ishlaydi va mobil qurilmalar uchun to'liq optimallashtirilgan.</p>
      </div>
    </div>
  </section>

  <section class="info-footer-line">
    <div class="container">
      <div class="info-content">
        <p class="info-footer-text">StarsPaymee &middot; sovgatg.uz &middot; @StarsPaymee_bot</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .info-hero {
    padding: 120px 24px 32px;
    background: #FFFFFF;
  }

  .breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--text-muted); margin-bottom: 32px;
  }
  .breadcrumb a { color: var(--primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .info-content { max-width: 760px; margin: 0 auto; }
  .info-title {
    font-size: 2.4rem; font-weight: 900; line-height: 1.15;
    margin-bottom: 16px; color: var(--text);
  }
  .info-meta {
    font-size: 0.95rem; color: var(--text-muted); line-height: 1.6;
  }

  .info-section { padding: 32px 24px; }
  .info-alt { background: #FFFFFF; }

  .info-content h2 {
    font-size: 1.4rem; font-weight: 800; margin-bottom: 20px; color: var(--text);
  }
  .info-content p {
    font-size: 0.95rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 12px;
  }
  .info-content p:last-child { margin-bottom: 0; }

  .info-footer-line {
    padding: 40px 24px;
    border-top: 1px solid var(--border);
  }
  .info-footer-text {
    text-align: center; font-size: 0.9rem; color: var(--text-muted); font-weight: 600;
  }

  @media (max-width: 640px) {
    .info-hero { padding: 100px 16px 40px; }
    .info-title { font-size: 1.6rem; }
    .info-meta { font-size: 0.85rem; }
    .info-section { padding: 24px 16px; }
    .info-content h2 { font-size: 1.2rem; margin-bottom: 16px; }
    .info-content p { font-size: 0.9rem; }
    .breadcrumb { margin-bottom: 20px; font-size: 0.8rem; }
  }
</style>
